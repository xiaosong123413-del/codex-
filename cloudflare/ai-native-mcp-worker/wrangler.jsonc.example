{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "llmwiki-ai-native-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "LLMWIKI_REMOTE_BRAIN_URL": "https://your-remote-brain.example.workers.dev",
    "LLMWIKI_WEBUI_URL": "https://your-llmwiki-webui.example.com",
    "LLMWIKI_OWNER_UID": "wechat-openclaw",
    "LLM_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "llm-wiki-remote-brain",
      "database_id": "replace-with-d1-id"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
