# =============================================================================
# llmwiki environment variables
# Copy this file to .env and fill in the values for your setup.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider (required for compile, query)
# -----------------------------------------------------------------------------

# Which LLM backend to use: anthropic | openai | gemini | ollama | minimax | cloudflare
# Default: anthropic
# LLMWIKI_PROVIDER=anthropic

# Model override (provider-specific defaults are used if not set)
# LLMWIKI_MODEL=claude-sonnet-4-20250514

# -----------------------------------------------------------------------------
# Anthropic (default provider)
# -----------------------------------------------------------------------------

# Option 1: API key
# ANTHROPIC_API_KEY=sk-ant-...

# Option 2: Auth token (from Claude CLI login)
# ANTHROPIC_AUTH_TOKEN=...

# Custom base URL (optional, for proxies or enterprise endpoints)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------

# OPENAI_API_KEY=sk-proj-...

# Custom base URL (optional)
# LLMWIKI_OPENAI_BASE_URL=https://api.openai.com/v1/

# -----------------------------------------------------------------------------
# Gemini
# -----------------------------------------------------------------------------

# GOOGLE_API_KEY=...

# Custom base URL (optional)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# -----------------------------------------------------------------------------
# Ollama (local models, no key needed)
# -----------------------------------------------------------------------------

# OLLAMA_HOST=http://localhost:11434/v1

# -----------------------------------------------------------------------------
# MiniMax
# -----------------------------------------------------------------------------

# MINIMAX_API_KEY=...

# Custom MiniMax Anthropic-compatible endpoint (optional)
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic

# -----------------------------------------------------------------------------
# Cloudflare Workers AI
# -----------------------------------------------------------------------------

# Option 1: Direct API access
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_API_TOKEN=...

# Option 2: Worker proxy
# CLOUDFLARE_WORKER_URL=https://your-worker.workers.dev
# CLOUDFLARE_REMOTE_TOKEN=...

# WeChat account login. Keep app secrets in the Worker secret store.
# WECHAT_MINI_PROGRAM_APP_ID=wx...
# WECHAT_MINI_PROGRAM_APP_SECRET=...
# Optional WeChat Open Platform website OAuth credentials.
# WECHAT_WEB_APP_ID=wx...
# WECHAT_WEB_APP_SECRET=...

# Model override
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Cloudflare Vectorize (for search)
# CLOUDFLARE_VECTORIZE_INDEX=...
# CLOUDFLARE_SEARCH_TOKEN=...
# CLOUDFLARE_SEARCH_MODEL=...
# CLOUDFLARE_SEARCH_ENDPOINT=...

# -----------------------------------------------------------------------------
# HTTP Proxy (optional)
# -----------------------------------------------------------------------------

# GLOBAL_AGENT_HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
