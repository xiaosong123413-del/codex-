# Test credentials - copy this to .env.test.local and fill in real values
# NEVER commit .env.test.local or any real secrets to version control

# App credentials (tenant_access_token flow)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# user_access_token - obtained via OAuth or developer console
# Required for: document creation visible to users, permission sharing
FEISHU_USER_ACCESS_TOKEN=

# Optional: a real user open_id to test permission sharing with
# e.g. ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_TEST_USER_OPEN_ID=
