{
  "name": "llm-wiki-compiler",
  "version": "0.1.1",
  "description": "A knowledge compiler CLI — raw sources in, interlinked wiki out",
  "type": "module",
  "bin": {
    "llmwiki": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "mcp": "node dist/mcp-server.js",
    "search:eval": "node scripts/search-eval.mjs",
    "search:eval:benchmark": "node scripts/search-eval.mjs --queries search/queries.benchmark.json --qrels search/qrels.benchmark.json",
    "wiki:static": "node scripts/build-public-wiki.mjs",
    "pages:deploy": "npm run wiki:static && npx wrangler pages functions build --outdir dist/static-wiki && npx wrangler pages deploy dist/static-wiki --project-name llm-wiki --branch main --commit-dirty=true",
    "web:sync-state": "node scripts/sync-web-state.mjs",
    "gui:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-gui.ps1",
    "desktop:webui:install": "npm --prefix desktop-webui install",
    "desktop:webui:dev": "npm --prefix desktop-webui run dev",
    "desktop:webui:start": "npm --prefix desktop-webui run start",
    "desktop:webui:build": "npm --prefix desktop-webui run build",
    "desktop:webui:launch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-desktop-webui.ps1",
    "desktop:webui:launcher:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop-webui-launcher.ps1",
    "public-package:check": "node scripts/assert-public-package-clean.mjs",
    "audit-shared:build": "npm --prefix audit-shared run build",
    "web:build": "npm run audit-shared:build && npm --prefix web install && npm --prefix web run build",
    "web:start": "npm --prefix web run start --",
    "obsidian-audit:build": "npm run audit-shared:build && npm --prefix plugins/obsidian-audit install && npm --prefix plugins/obsidian-audit run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "knowledge",
    "wiki",
    "llm",
    "compiler",
    "markdown",
    "obsidian"
  ],
  "license": "MIT",
  "author": "Ethan Joffe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atomicmemory/llm-wiki-compiler.git"
  },
  "homepage": "https://github.com/atomicmemory/llm-wiki-compiler#readme",
  "bugs": {
    "url": "https://github.com/atomicmemory/llm-wiki-compiler/issues"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@lancedb/lancedb": "^0.27.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.5.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "chokidar": "^4.0.0",
    "commander": "^13.0.0",
    "dotenv": "^17.4.0",
    "global-agent": "^3.0.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^25.0.0",
    "mammoth": "^1.12.0",
    "openai": "^4.0.0",
    "p-limit": "^6.0.0",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "turndown": "^7.2.0",
    "undici": "^7.25.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.0",
    "@types/turndown": "^5.0.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "sigma": "^3.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
